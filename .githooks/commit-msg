#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/../scripts/logger.sh"

PREFIXES="feat|fix|docs|refactor|perf|test|build|ci|chore|revert"
PATTERN="^($PREFIXES)(\([a-zA-Z0-9-]+\))?(!)?: .+$"
MAX_LENGTH=70

main() {
    local header failure=""

    header="$(head -n1 "$1")"

    log_context "Commit message: $header"

    if [ -z "$header" ]; then
        log_finding "message cannot be empty"
        failure="empty message"
    elif ! echo "$header" | grep -qE "$PATTERN"; then
        log_finding "expected <type>(<scope>)?(!)?: <subject>"
        log_finding "allowed types: ${PREFIXES//|/, }"
        failure="invalid format"
    elif [ "${#header}" -gt "$MAX_LENGTH" ]; then
        log_finding "header is ${#header} characters, maximum is $MAX_LENGTH"
        failure="header is too long"
    fi

    if [ -n "$failure" ]; then
        log_verdict "failed" "COMMIT FAILED:" "$failure"
        exit 1
    fi

    log_verdict "passed" "COMMIT MESSAGE ACCEPTED:" "format and length are valid"
}

main "$@"
