#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/../scripts/logger.sh"

OUTPUT_FILE=""

STEP_FUNCTIONS=(step_gitleaks step_env step_intl step_tsc step_knip step_eslint step_unit_tests step_integration_tests)
STEP_TITLES=("Secret scan" "Environment" "Translations" "Type check" "Unused code" "Lint" "Unit tests" "Integration tests")

remove_output_file() {
    if [ -n "$OUTPUT_FILE" ] && [ -f "$OUTPUT_FILE" ]; then
        rm -f "$OUTPUT_FILE"
    fi
}

step_gitleaks() {
    if ! command -v gitleaks >/dev/null 2>&1; then
        log_finding "gitleaks is not installed, see CONTRIBUTING.md"
        return 1
    fi

    if pnpm run secrets:check >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_env() {
    if LOG_NESTED=1 pnpm --silent run env:check >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_intl() {
    if LOG_NESTED=1 pnpm --silent run intl:check >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_tsc() {
    if pnpm run tsc >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_knip() {
    if pnpm run knip >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_eslint() {
    if pnpm run lint >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_unit_tests() {
    if pnpm run test:unit --ci >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_integration_tests() {
    if ! docker info >"$OUTPUT_FILE" 2>&1; then
        log_finding "Docker is required for integration tests; start Docker and retry (see CONTRIBUTING.md)"
        log_output "$OUTPUT_FILE"
        return 1
    fi

    if pnpm run test:integration --ci >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

run_step() {
    local number="$1" title="$2" step="$3" started status

    log_step "$number. $title"
    started="$(now_ms)"

    if "$step"; then
        status="passed"
    else
        status="failed"
    fi

    log_result "$status" "$(($(now_ms) - started))"

    [ "$status" = "passed" ]
}

main() {
    local index number failed=""

    OUTPUT_FILE="$(mktemp)" || exit 1
    trap remove_output_file EXIT

    for index in "${!STEP_TITLES[@]}"; do
        number=$((index + 1))

        if [ -n "$failed" ]; then
            log_step "$number. ${STEP_TITLES[$index]}"
            log_result "skipped"
            continue
        fi

        if ! run_step "$number" "${STEP_TITLES[$index]}" "${STEP_FUNCTIONS[$index]}"; then
            failed="${STEP_TITLES[$index]}"
        fi
    done

    if [ -n "$failed" ]; then
        log_verdict "failed" "COMMIT FAILED:" "$failed"
        exit 1
    fi

    log_verdict "passed" "COMMIT SUCCEEDED:" "${#STEP_TITLES[@]} of ${#STEP_TITLES[@]} steps passed"
}

main
