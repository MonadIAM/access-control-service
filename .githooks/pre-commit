#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/../scripts/logger.sh"

FILES_FOR_CHECK=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.ts$" | grep -v "node_modules")
OUTPUT_FILE=""

STEP_FUNCTIONS=(step_gitleaks step_env step_intl step_tsc step_knip step_eslint)
STEP_TITLES=("Gitleaks" "Env" "Intl" "TSC" "Knip" "ESLint")

remove_output_file() {
    if [ -n "$OUTPUT_FILE" ] && [ -f "$OUTPUT_FILE" ]; then
        rm -f "$OUTPUT_FILE"
    fi
}

step_gitleaks() {
    if ! command -v gitleaks >/dev/null 2>&1; then
        log_finding "gitleaks is not installed, see CONTRIBUTING.md"
        return 1
    fi

    if gitleaks protect --staged --config .gitleaks.toml >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_env() {
    if LOG_NESTED=1 ./scripts/env.check.sh >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_intl() {
    if LOG_NESTED=1 ./scripts/intl.check.sh >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_tsc() {
    if npx tsc --noEmit >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_knip() {
    if pnpm run knip >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

step_eslint() {
    if echo "$FILES_FOR_CHECK" | xargs npx eslint --quiet >"$OUTPUT_FILE" 2>&1; then
        return 0
    fi

    log_output "$OUTPUT_FILE"
    return 1
}

run_step() {
    local number="$1" title="$2" step="$3" started status

    log_step "$number. $title"
    started="$(now_ms)"

    if "$step"; then
        status="passed"
    else
        status="failed"
    fi

    log_result "$status" "$(($(now_ms) - started))"

    [ "$status" = "passed" ]
}

main() {
    local index number failed=""

    OUTPUT_FILE="$(mktemp)"
    trap remove_output_file EXIT

    if [ -n "$FILES_FOR_CHECK" ]; then
        log_context "Files to be linted:" $FILES_FOR_CHECK
    fi

    for index in "${!STEP_TITLES[@]}"; do
        number=$((index + 1))

        if [ -n "$failed" ]; then
            log_step "$number. ${STEP_TITLES[$index]}"
            log_result "skipped"
            continue
        fi

        if ! run_step "$number" "${STEP_TITLES[$index]}" "${STEP_FUNCTIONS[$index]}"; then
            failed="${STEP_TITLES[$index]}"
        fi
    done

    if [ -n "$failed" ]; then
        log_verdict "failed" "COMMIT FAILED:" "$failed"
        exit 1
    fi

    log_verdict "passed" "COMMIT SUCCEEDED:" "${#STEP_TITLES[@]} of ${#STEP_TITLES[@]} steps passed"
}

main
