#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/../scripts/logger.sh"

PREFIXES="feat|fix|docs|refactor|perf|test|build|ci|chore|revert"
PATTERN="^($PREFIXES)(/[a-zA-Z0-9-]+)?/[a-zA-Z0-9_-]+$"
WHITELIST="^(dev|main|master)$"
MAX_LENGTH=50

main() {
    local branch failure=""

    branch="$(git rev-parse --abbrev-ref HEAD)"

    log_context "Branch: $branch"

    if echo "$branch" | grep -qE "$WHITELIST"; then
        log_verdict "passed" "PUSH ALLOWED:" "protected branch, name checks skipped"
        exit 0
    fi

    if ! echo "$branch" | grep -qE "$PATTERN"; then
        log_finding "expected <type>/<scope>?/<slug>"
        log_finding "allowed types: ${PREFIXES//|/, }"
        failure="invalid format"
    elif [ "${#branch}" -gt "$MAX_LENGTH" ]; then
        log_finding "branch name is ${#branch} characters, maximum is $MAX_LENGTH"
        failure="branch name is too long"
    fi

    if [ -n "$failure" ]; then
        log_verdict "failed" "PUSH FAILED:" "$failure"
        exit 1
    fi

    log_verdict "passed" "PUSH ALLOWED:" "format and length are valid"
}

main "$@"
