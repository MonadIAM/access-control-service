#!/usr/bin/env bash

ESC=$(printf "\033")
RED="${ESC}[31m"
YELLOW="${ESC}[33m"
BG_RED="${ESC}[41m"
RESET="${ESC}[0m"

PREFIXES="feat|fix|docs|refactor|perf|test|build|ci|chore|revert"
MAX_LENGTH=50

PATTERN="^($PREFIXES)(/[a-zA-Z0-9-]+)?/[a-zA-Z0-9_-]+$"
WHITELIST="^(dev|main|master)$"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
BRANCH_LEN=${#CURRENT_BRANCH}

if echo "$CURRENT_BRANCH" | grep -qE "$WHITELIST"; then
    exit 0
fi

if ! echo "$CURRENT_BRANCH" | grep -qE "$PATTERN"; then
    printf "\n${BG_RED}PUSH FAILED:${RESET}${RED} Invalid branch name format!${RESET}\n"
    exit 1
fi

if [ "$BRANCH_LEN" -gt "$MAX_LENGTH" ]; then
    printf "\n${BG_RED}PUSH FAILED:${RESET}${RED} Branch name is too long!${RESET}\n"
    printf "Current length: ${BRANCH_LEN} characters (max: ${MAX_LENGTH})\n"
    exit 1
fi

run_knip() {
    local start_time end_time elapsed exit_code

    start_time=$(date +%s)
    npm run knip --silent >/dev/null 2>&1
    exit_code=$?
    end_time=$(date +%s)
    elapsed=$((end_time - start_time))

    printf "\n${YELLOW}Knip execution time: ${elapsed} sec${RESET}\n"
    return $exit_code
}

run_knip
if [ $? -ne 0 ]; then
    printf "\n${BG_RED}PUSH FAILED:${RESET}${RED} Knip detected unused code or dependencies.${RESET}\n"
    exit 1
fi

exit 0
