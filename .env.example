# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="access-control-service"
NODE_ENV="development"
API_VERSION="1"

APP_BASE_IMAGE="node:22.13.0-alpine3.21"
GRPC_HOST="0.0.0.0"
GRPC_PORT="50051"
APP_HOST="0.0.0.0"
APP_PORT="5002"
THROTTLE_LIMIT="20"
THROTTLE_TTL="1m"
HSTS_MAX_AGE="1y"
BODY_LIMIT_BYTES="5242880"
JWT_ISSUER="identity-service"
JWT_JWKS_URL="http://identity-service:5001/api/v1/.well-known/jwks.json"

# ---------------------------------------------------------------------------
# PostgreSQL - common
# ---------------------------------------------------------------------------

POSTGRES_IMAGE="postgres:17.2-alpine3.21"
POSTGRES_DB="access-control-service"
POSTGRES_USER="lambdius"
POSTGRES_PASSWORD="d7J!t9fXz2Qw*1Vr"
POSTGRES_PORT="6021"
POSTGRES_REPLICA_PORT="6022"
POSTGRES_CONTAINER_PORT="5432"
POSTGRES_SSL="false"
POSTGRES_SSL_REJECT_UNAUTHORIZED="false"
POSTGRES_POOL_MAX="2"
POSTGRES_POOL_IDLE_MS="30s"
POSTGRES_LOGGING="true"
POSTGRES_CQRS_ENABLED="true"

# ---------------------------------------------------------------------------
# PostgreSQL - write-side
# ---------------------------------------------------------------------------

POSTGRES_WRITE_POOL_MAX="2"
POSTGRES_WRITE_POOL_IDLE_MS="30s"

# ---------------------------------------------------------------------------
# PostgreSQL - read-side
# ---------------------------------------------------------------------------

POSTGRES_READ_POOL_MAX="4"
POSTGRES_READ_POOL_IDLE_MS="30s"

# ---------------------------------------------------------------------------
# PostgreSQL - replication
# ---------------------------------------------------------------------------

POSTGRES_REPLICATION_USER="repl_user"
POSTGRES_REPLICATION_PASSWORD="R3pl!c4t0r#Str0ng"
POSTGRES_REPLICATION_SLOT="access_control_replica_1"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_IMAGE="redis:7.4.2-alpine3.21"
REDIS_PORT="7021"
REDIS_CONTAINER_PORT="6379"
REDIS_PASSWORD="12345"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300ms"
DOCKER_NETWORK_NAME="kafka-net"
KAFKA_CONNECT_IMAGE="quay.io/debezium/connect:3.0"
KAFKA_TOPIC_PREFIX="access-control"
KAFKA_CONNECT_PORT="8084"
KAFKAJS_NO_PARTITIONER_WARNING="1"
KAFKA_DLQ_MAX_RETRIES="5"
KAFKA_DLQ_RETRY_BASE_DELAY="5s"
KAFKA_DLQ_RETRY_JITTER="1s"

# ---------------------------------------------------------------------------
# Debezium
# ---------------------------------------------------------------------------

DEBEZIUM_INIT_IMAGE="alpine:3.21"

# ---------------------------------------------------------------------------
# Domain-specific limits
# ---------------------------------------------------------------------------

REALM_LIMIT="25"
ROLE_PER_REALM_LIMIT="100"
ROLE_PER_ACCOUNT_LIMIT="15"
PERMISSION_PER_REALM_LIMIT="500"
PERMISSION_PER_ROLE_LIMIT="200"
PERMISSION_OVERRIDE_PER_ACCOUNT_LIMIT="30"
CONFLICT_GROUP_PER_REALM_LIMIT="30"
MAX_CONFLICT_MEMBERS_COUNT="20"
DELEGATION_POLICY_PER_ROLE_LIMIT="20"
MAX_ROLE_SUBTREE_SIZE_FOR_PURGE="50"
BULK_OPERATION_LIMIT="100"

