SERVICE_NAME="access-control-service" # Название сервиса.
NODE_ENV="development"                # Режим окружения приложения.

APP_BASE_IMAGE="node:22.13.0-alpine3.21" # Базовый Docker-образ для сборки и запуска Node.js приложения.
APP_HOST="0.0.0.0"                       # Сетевой интерфейс, который будет прослушивать приложение.
APP_PORT="5001"                          # Порт HTTP-сервера приложения.

# Конфигурация PostgreSQL
POSTGRESQL_IMAGE="postgres:17.2-alpine3.21" # Docker-образ PostgreSQL.
POSTGRESQL_HOST="postgresql"                # Хост PostgreSQL внутри Docker-сети.
POSTGRESQL_PORT="5432"                      # Порт PostgreSQL. Стандартный порт 5432.
POSTGRESQL_USER="lambdius"                  # Имя пользователя БД с правами на подключение и управление схемами.
POSTGRESQL_PASS="d7J!t9fXz2Qw*1Vr"          # Пароль пользователя БД.
POSTGRESQL_NAME="access-control-service"    # Имя базы данных, используемой сервисом.
POSTGRESQL_SSL="false"                      # Включение SSL для БД
POSTGRESQL_SSL_REJECT_UNAUTHORIZED="false"  # Проверка сертификата
POSTGRESQL_POOL_IDLE_MS="30000"             # Таймаут простоя соединения в пуле (мс). Рекомендовано 30000 = 30с.
POSTGRESQL_POOL_MAX="2"                     # Максимум соединений в пуле на процесс приложения.
POSTGRESQL_LOGGING="true"                  # Логи SQL/ошибок на уровне ORM/драйвера. В prod ставь false.

# Конфигурация Redis
REDIS_IMAGE="redis:7.4.2-alpine3.21" # Docker-образ Redis.
REDIS_HOST="redis"                   # Хост Redis-сервера внутри Docker-сети.
REDIS_PORT="6379"                    # Порт Redis-сервера. Стандартный порт 6379.
REDIS_PASSWORD="12345"               # Пароль доступа к Redis.
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# Конфигурация Kafka
KAFKA_BROKER="kafka:29092"      # Адрес брокера Kafka внутри Docker-сети.
KAFKA_RETRY_ATTEMPTS="10"       # Количество попыток подключения.
KAFKA_RETRY_INITIAL_TIME="300"  # Начальная задержка между попытками (мс).
DOCKER_NETWORK_NAME="kafka-net" # Имя внешней сети для связи между микросервисами.
