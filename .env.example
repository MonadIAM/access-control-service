SERVICE_NAME="access-control-service" # Название сервиса.
NODE_ENV="development"                # Режим окружения приложения.

APP_BASE_IMAGE="node:22.13.0-alpine3.21" # Базовый Docker-образ для сборки и запуска Node.js приложения.
APP_HOST="0.0.0.0"                       # Сетевой интерфейс, который будет прослушивать приложение.
APP_PORT="5001"                          # Порт HTTP-сервера приложения.
THROTTLE_LIMIT="20"                      # Максимальное кол-во запросов с одного IP в течение окна времени TTL.
THROTTLE_TTL="60000"                     # Временной интервал в миллисекундах, для которого рассчитывается лимит запросов.

# Конфигурация PostgreSQL
POSTGRESQL_IMAGE="postgres:17.2-alpine3.21" # Docker-образ PostgreSQL (для legacy / single-node сценариев).
POSTGRESQL_PORT="5432"                      # Порт PostgreSQL. Стандартный порт 5432.
POSTGRESQL_REPLICA_PORT="5433"              # Порт для replica (внешний доступ).
POSTGRESQL_USER="lambdius"                  # Имя пользователя БД с правами на подключение и управление схемами.
POSTGRESQL_PASS="d7J!t9fXz2Qw*1Vr"          # Пароль пользователя БД.
POSTGRESQL_NAME="access-control-service"    # Имя базы данных, используемой сервисом.
POSTGRESQL_SSL="false"                      # Включение SSL для БД.
POSTGRESQL_SSL_REJECT_UNAUTHORIZED="false"  # Проверка сертификата сервера.
POSTGRESQL_POOL_IDLE_MS="30000"             # Таймаут простоя соединения в пуле (мс). 30000 = 30с.
POSTGRESQL_POOL_MAX="2"                     # Максимум соединений в пуле на процесс приложения.
POSTGRESQL_LOGGING="false"                  # Логи SQL/ошибок на уровне ORM/драйвера. В prod — false.
POSTGRESQL_CQRS_ENABLED="true"              # true — раздельные подключения (write/read) / false — single-connection режим.
POSTGRESQL_HOST="postgresql-primary"        # Хост PostgreSQL для single-connection режима.

POSTGRESQL_WRITE_HOST="postgresql-primary"  # Хост primary-инстанса PostgreSQL.
POSTGRESQL_WRITE_PORT="5432"                # Порт primary-инстанса PostgreSQL.
POSTGRESQL_WRITE_POOL_MAX="2"               # Максимум соединений в пуле для write-side.
POSTGRESQL_WRITE_POOL_IDLE_MS="30000"       # Таймаут простоя соединений write-side (мс).

POSTGRESQL_READ_HOST="postgresql-replica"   # Хост read-replica PostgreSQL.
POSTGRESQL_READ_PORT="5432"                 # Порт read-replica PostgreSQL.
POSTGRESQL_READ_POOL_MAX="4"                # Максимум соединений в пуле для read-side.
POSTGRESQL_READ_POOL_IDLE_MS="30000"        # Таймаут простоя соединений read-side (мс).

POSTGRESQL_REPLICATION_USER="repl_user"                # Пользователь репликации (REPLICATION role).
POSTGRESQL_REPLICATION_PASSWORD="R3pl!c4t0r#Str0ng"    # Пароль пользователя репликации.
POSTGRESQL_REPLICATION_SLOT="access_control_replica_1" # Имя physical replication slot для read-replica.

# Конфигурация Redis
REDIS_IMAGE="redis:7.4.2-alpine3.21" # Docker-образ Redis.
REDIS_HOST="redis"                   # Хост Redis-сервера внутри Docker-сети.
REDIS_PORT="6379"                    # Порт Redis-сервера. Стандартный порт 6379.
REDIS_PASSWORD="12345"               # Пароль доступа к Redis.
REDIS_DB_CACHE="0"                   # Индекс БД для кэширования данных.
REDIS_DB_LIMITER="1"                 # Индекс БД для Rate Limiter'ов.
REDIS_DB_QUEUE="2"                   # Индекс БД для очередей задач (BullMQ).

# Конфигурация Kafka
KAFKA_BROKER="kafka:29092"      # Адрес брокера Kafka внутри Docker-сети.
KAFKA_RETRY_ATTEMPTS="10"       # Количество попыток подключения.
KAFKA_RETRY_INITIAL_TIME="300"  # Начальная задержка между попытками (мс).
DOCKER_NETWORK_NAME="kafka-net" # Имя внешней сети для связи между микросервисами.
