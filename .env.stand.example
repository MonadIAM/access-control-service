# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="access-control-service"
NODE_ENV="stand"
API_VERSION="1"
APP_BASE_IMAGE="node:24.18.0-alpine3.24"
APP_HOST="0.0.0.0"
APP_PORT="4001"
GRPC_HOST="127.0.0.1"
GRPC_PORT="50051"
THROTTLE_LIMIT="20"
THROTTLE_TTL="1m"
HSTS_MAX_AGE="1y"
BODY_LIMIT_BYTES="5242880"
JWT_ISSUER="identity-service"
JWT_JWKS_URL="http://identity-service:4002/api/v1/.well-known/jwks.json"
JWT_JWKS_COOLDOWN_DURATION="30s"
JWT_JWKS_TIMEOUT_DURATION="5s"
JWT_JWKS_CACHE_MAX_AGE="10m"
IDENTITY_SERVICE_URL="http://localhost:4002"
ACCESS_CONTROL_SERVICE_URL="http://localhost:4001"
NOTIFICATION_SERVICE_URL="http://localhost:4003"
TEMPLATE_SERVICE_URL="http://localhost:4000"
DOCS_OAUTH_CLIENT_ID="00000003-0000-4000-8000-130000000002"
ALLOWED_SERVICE_ORIGINS='["http://localhost:4000","http://localhost:4001","http://localhost:4002","http://localhost:4003"]'
ALLOWED_UI_ORIGINS='[]'

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------

OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"
OTEL_LOG_LEVEL="INFO"
OTEL_LOGS_EXPORTER="none"
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG="0.2"

# ---------------------------------------------------------------------------
# Loki
# ---------------------------------------------------------------------------

LOKI_ENABLED="true"
LOKI_URL="http://loki:3100"
LOKI_BATCH_INTERVAL="5"

# ---------------------------------------------------------------------------
# PostgreSQL - common
# ---------------------------------------------------------------------------

POSTGRES_DB="access-control-service"
POSTGRES_SSL_ENABLED="true"
POSTGRES_SSL_REJECT_UNAUTHORIZED="true"
POSTGRES_SSL_CA_FILE="/tls/ca.crt"
POSTGRES_SSL_CERT_FILE="/tls/client.crt"
POSTGRES_SSL_KEY_FILE="/tls/client.key"
POSTGRES_LOGGING="true"

# ---------------------------------------------------------------------------
# PostgreSQL - write
# ---------------------------------------------------------------------------

POSTGRES_WRITE_HOST="access-control-postgres-haproxy"
POSTGRES_WRITE_PORT="6432"
POSTGRES_WRITE_POOL_MAX="2"
POSTGRES_WRITE_POOL_IDLE_MS="30s"

# ---------------------------------------------------------------------------
# PostgreSQL - read
# ---------------------------------------------------------------------------

POSTGRES_READ_HOST="access-control-postgres-haproxy"
POSTGRES_READ_PORT="6433"
POSTGRES_READ_POOL_MAX="4"
POSTGRES_READ_POOL_IDLE_MS="30s"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_HOST="access-control-redis"
REDIS_PORT="6379"
REDIS_TLS_ENABLED="true"
REDIS_TLS_REJECT_UNAUTHORIZED="true"
REDIS_TLS_CA_FILE="/tls/ca.crt"
REDIS_TLS_CERT_FILE="/tls/client.crt"
REDIS_TLS_KEY_FILE="/tls/client.key"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_SSL_ENABLED="true"
KAFKA_SASL_ENABLED="true"
KAFKA_SSL_REJECT_UNAUTHORIZED="true"
KAFKA_SSL_CA_FILE="/tls/ca.crt"
KAFKA_SSL_CERT_FILE="/tls/client.crt"
KAFKA_SSL_KEY_FILE="/tls/client.key"
KAFKA_SASL_USERNAME="access-control-service"
KAFKA_SASL_PASSWORD_FILE="/vault/secrets/kafka_sasl_password"
KAFKA_PARTITIONS_CONSUMED_CONCURRENTLY="4"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300ms"
KAFKA_PROJECTION_RETRY_INITIAL_DELAY="500ms"
KAFKA_PROJECTION_RETRY_MAX_DELAY="10s"
KAFKAJS_NO_PARTITIONER_WARNING="1"
KAFKA_DLQ_MAX_RETRIES="5"
KAFKA_DLQ_RETRY_BASE_DELAY="5s"
KAFKA_DLQ_RETRY_JITTER="1s"

# ---------------------------------------------------------------------------
# Schema Registry
# ---------------------------------------------------------------------------

SCHEMA_REGISTRY_URL="http://schema-registry-main:8080/apis/ccompat/v7"
SCHEMA_REGISTRY_ENABLED="true"

# ---------------------------------------------------------------------------
# BullMQ - cleanup
# ---------------------------------------------------------------------------

AUDIT_LOG_RETENTION_TTL="14d"
CHANGE_LOG_RETENTION_TTL="14d"
INBOX_RETENTION_TTL="14d"
CLEANUP_BATCH_SIZE="100"
CLEANUP_BATCH_DELAY="5s"
CLEANUP_BATCH_BACKOFF_DELAY="10s"
CLEANUP_BATCH_ATTEMPTS="3"

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

DOCKER_NETWORK_MONITORING="monitoring-network"
DOCKER_NETWORK_KAFKA="kafka-net"
DOCKER_NETWORK_POSTGRES="postgres-net"
DOCKER_NETWORK_REDIS="redis-net"
DOCKER_NETWORK_VAULT="vault-net"
DOCKER_VOLUME_VAULT_CA="vault_ca"
DOCKER_VOLUME_SERVICE_TLS="service_tls"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

VAULT_IMAGE="hashicorp/vault:1.21.3"
VAULT_AGENT_SOCKET_PATH="/vault/proxy/agent.sock"
VAULT_PORT="8200"
VAULT_APPROLE_NAME="access-control-service"
VAULT_TRANSIT_MOUNT="transit"
VAULT_TRANSIT_AUDIT_MASK_KEY="access-control-audit-mask-hmac"
VAULT_TRANSIT_AUDIT_LOG_KEY="access-control-audit-log-sig"

# ---------------------------------------------------------------------------
# Vault (bootstrap)
# ---------------------------------------------------------------------------

VAULT_PROVISIONER_TOKEN=""

# ---------------------------------------------------------------------------
# Domain-specific limits
# ---------------------------------------------------------------------------

REALM_LIMIT="25"
ROLE_PER_REALM_LIMIT="100"
ROLE_PER_ACCOUNT_LIMIT="15"
PERMISSION_PER_REALM_LIMIT="500"
PERMISSION_PER_ROLE_LIMIT="200"
PERMISSION_OVERRIDE_PER_ACCOUNT_LIMIT="30"
CONFLICT_GROUP_PER_REALM_LIMIT="30"
MAX_CONFLICT_MEMBERS_COUNT="20"
DELEGATION_POLICY_PER_ROLE_LIMIT="20"
MAX_ROLE_SUBTREE_SIZE_FOR_PURGE="50"
BULK_OPERATION_LIMIT="100"
