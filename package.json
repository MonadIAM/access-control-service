{
  "name": "@monadiam/access-control-service",
  "description": "Access Control Service implementing HRBAC, DAC, SoD (N-of-M), Delegation Policies, Multitenancy and Invitation mechanics, with Audit and Change Log support.",
  "author": "Daniil Egorov (https://github.com/Lambdius)",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.1",
  "main": "dist/index.js",
  "engines": {
    "node": "22.17.0"
  },
  "config": {
    "engine-strict": true
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --config ./prettier.config.mjs --fix --format json | node -e \"process.stdin.on('data',d=>JSON.parse(d).forEach(f=>f.output && console.log(f.filePath)));\"",
    "swagger": "ts-node --transpile-only -r tsconfig-paths/register cli/swagger/main.ts",
    "postman": "ts-node --transpile-only cli/postman/main.ts",
    "knip": "knip --config configs/knip.config.ts",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/index.js",
    "start:dev": "nest start --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonadIAM/access-control-service.git"
  },
  "bugs": {
    "url": "https://github.com/MonadIAM/access-control-service/issues"
  },
  "homepage": "https://github.com/MonadIAM/access-control-service#readme",
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@monadiam/shared": "github:MonadIAM/shared#v1.0.27",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "5.2.3",
    "@grpc/grpc-js": "1.14.4",
    "@mikro-orm/core": "6.6.4",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.6.4",
    "@nest-lab/throttler-storage-redis": "1.1.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/config": "4.0.2",
    "@nestjs/microservices": "11.1.12",
    "@nestjs/platform-fastify": "11.1.8",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.2.5",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.5.0",
    "@willsoto/nestjs-prometheus": "6.0.2",
    "class-transformer": "0.5.1",
    "ioredis": "5.9.2",
    "jose": "6.1.3",
    "kafkajs": "2.2.4",
    "libphonenumber-js": "1.13.3",
    "ms": "2.1.3",
    "nestjs-i18n": "10.6.0",
    "nestjs-pino": "4.5.0",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@jest/types": "30.2.0",
    "@mikro-orm/cli": "6.6.4",
    "@mikro-orm/entity-generator": "6.6.4",
    "@mikro-orm/migrations": "6.6.4",
    "@mikro-orm/seeder": "6.6.4",
    "@nestjs/cli": "11.0.16",
    "@types/ms": "2.1.0",
    "@types/node": "24.9.2",
    "@typescript-eslint/parser": "8.46.2",
    "dotenv": "17.2.3",
    "eslint": "9.38.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "jest": "30.2.0",
    "knip": "6.15.0",
    "openapi-to-postmanv2": "6.0.1",
    "prettier": "3.6.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
