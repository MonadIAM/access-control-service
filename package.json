{
  "name": "@monadiam/access-control-service",
  "description": "IAM | Access Control & AuthZ: hierarchical RBAC, DAC permission overrides, separation of duties (SoD), role delegation policies and realm-scoped access control.",
  "author": "Daniil Egorov (https://github.com/Lambdius)",
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.0.6",
  "main": "dist/index.js",
  "engines": {
    "node": "24.18.0"
  },
  "config": {
    "engine-strict": true
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --config ./prettier.config.mjs --fix --format json | node -e \"process.stdin.on('data',d=>JSON.parse(d).forEach(f=>f.output && console.log(f.filePath)));\"",
    "tsc": "tsc --noEmit",
    "knip": "knip --config configs/knip.config.ts",
    "secrets:check": "gitleaks protect --staged --config .gitleaks.toml",
    "env:check": "bash scripts/env.check.sh",
    "intl:types": "nestjs-i18n -p src/common/dictionaries -o src/common/dictionaries/intl.generated.ts",
    "intl:check": "bash scripts/intl.check.sh",
    "lsp": "lsmcp --config .lsmcp/config.json",
    "db:migration": "mikro-orm migration:create",
    "db:migrate": "mikro-orm migration:up",
    "db:seed": "pnpm run db:seed:postgresql && pnpm run db:seed:redis",
    "db:seed:redis": "tsx src/infrastructure/redis/system.seeder.ts",
    "db:seed:redis:demo": "tsx src/infrastructure/redis/demo.seeder.ts",
    "db:seed:postgresql": "mikro-orm seeder:run",
    "utest": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.unit.config.mjs",
    "itest": "NODE_OPTIONS='--import tsx --experimental-vm-modules' jest --config ./jest.integration.config.mjs",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run utest",
    "test:integration": "pnpm run itest",
    "start:prod": "node dist/index.js",
    "start:dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "coverage:unit": "pnpm run utest --coverage --coverageDirectory=coverage/unit",
    "coverage:integration": "pnpm run itest --coverage --coverageDirectory=coverage/integration",
    "coverage:all": "NODE_OPTIONS='--import tsx --experimental-vm-modules' jest --config ./jest.coverage.config.mjs --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonadIAM/access-control-service.git"
  },
  "bugs": {
    "url": "https://github.com/MonadIAM/access-control-service/issues"
  },
  "homepage": "https://github.com/MonadIAM/access-control-service#readme",
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "tsx",
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.20.1",
    "@grpc/grpc-js": "1.14.4",
    "@kafkajs/confluent-schema-registry": "4.1.0",
    "@libpg-query/parser": "17.6.10",
    "@mikro-orm/cli": "7.1.13",
    "@mikro-orm/core": "7.1.13",
    "@mikro-orm/migrations": "7.1.13",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.13",
    "@mikro-orm/seeder": "7.1.13",
    "@monadiam/shared": "github:MonadIAM/shared#v3.4.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/microservices": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scalar/fastify-api-reference": "1.67.0",
    "@willsoto/nestjs-prometheus": "6.1.0",
    "bullmq": "6.2.0",
    "bullmq-otel": "2.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.3",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "kafkajs": "2.2.4",
    "kysely": "0.29.5",
    "libphonenumber-js": "1.13.11",
    "ms": "2.1.3",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-loki": "3.0.0",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.12",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@fastify/static": "10.1.3",
    "@jest/globals": "30.4.1",
    "@mikro-orm/entity-generator": "7.1.13",
    "@mizchi/lsmcp": "0.10.0",
    "@nestjs/cli": "11.0.24",
    "@testcontainers/postgresql": "12.1.0",
    "@types/har-format": "1.2.16",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "typescript-language-server": "5.1.3"
  }
}
