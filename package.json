{
  "name": "@monadiam/access-control-service",
  "description": "Access Control Service implementing HRBAC, DAC, SoD (N-of-M), Delegation Policies, Multitenancy and Invitation mechanics, with Audit and Change Log support.",
  "author": "Daniil Egorov (https://github.com/Lambdius)",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.1",
  "main": "dist/index.js",
  "engines": {
    "node": "24.18.0"
  },
  "config": {
    "engine-strict": true
  },
  "scripts": {
    "lint": "eslint .",
    "swagger": "tsx cli/swagger/main.ts",
    "postman": "tsx cli/postman/main.ts",
    "knip": "knip --config configs/knip.config.ts",
    "start:prod": "node dist/index.js",
    "start:dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonadIAM/access-control-service.git"
  },
  "bugs": {
    "url": "https://github.com/MonadIAM/access-control-service/issues"
  },
  "homepage": "https://github.com/MonadIAM/access-control-service#readme",
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "tsx",
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/otel": "0.20.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@grpc/grpc-js": "1.14.4",
    "@mikro-orm/core": "7.1.8",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.8",
    "@monadiam/shared": "github:MonadIAM/shared#v1.0.38",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/config": "4.0.4",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@willsoto/nestjs-prometheus": "6.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "kafkajs": "2.2.4",
    "knex": "3.3.0",
    "libphonenumber-js": "1.13.9",
    "ms": "2.1.3",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@fastify/static": "9.3.0",
    "@mikro-orm/cli": "7.1.8",
    "@mikro-orm/entity-generator": "7.1.8",
    "@mikro-orm/migrations": "7.1.8",
    "@mikro-orm/seeder": "7.1.8",
    "@nestjs/cli": "11.0.24",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@typescript-eslint/parser": "8.65.0",
    "dotenv": "17.4.2",
    "eslint": "9.38.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.8.0",
    "jest": "30.4.2",
    "knip": "6.29.0",
    "openapi-to-postmanv2": "6.3.1",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
