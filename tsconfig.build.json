{
  "extends": "./configs/tsconfig.base.json",  // Root config, better to avoid editing!
  "compilerOptions": {
    "rootDir": ".",                           // Root directory of the source code
    "baseUrl": ".",                           // Base directory for resolving relative paths
    "outDir": "./dist",                       // Output directory for compiled files
    "paths": {
      "~infrastructure": ["src/infrastructure"],
      "~infrastructure/*": ["src/infrastructure/*"],
      "~observability": ["src/observability"],
      "~observability/*": ["src/observability/*"],
      "~bootstrap": ["src/bootstrap"],
      "~bootstrap/*": ["src/bootstrap/*"],
      "~context": ["src/context"],
      "~context/*": ["src/context/*"],
      "~common": ["src/common"],
      "~common/*": ["src/common/*"],
    },
  },
  "include": [
    "./env.d.ts",
    "src/**/*",
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "node_modules",
    "configs",
    "dist",
  ],
}
