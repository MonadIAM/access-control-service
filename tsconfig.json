{
  "extends": "./configs/tsconfig.base.json",  // Корневой конфиг, лучше воздержаться от редактирования!
  "compilerOptions": {
    "rootDir": ".",                           // Корневая директория исходного кода
    "baseUrl": ".",                           // Базовая директория для разрешения относительных путей
    "outDir": "./dist",                       // Директория для скомпилированных файлов
    "paths": {
      "~infrastructure": ["src/infrastructure"],
      "~infrastructure/*": ["src/infrastructure/*"],
      "~observability": ["src/observability"],
      "~observability/*": ["src/observability/*"],
      "~bootstrap": ["src/bootstrap"],
      "~bootstrap/*": ["src/bootstrap/*"],
      "~contexts": ["src/contexts"],
      "~contexts/*": ["src/contexts/*"],
      "~common": ["src/common"],
      "~common/*": ["src/common/*"],
    },
  },
  "include": [
    "./mikro-orm.config.ts",
    "./jest.unit.config.ts",
    "./jest.e2e.config.ts",
    "./env.d.ts",
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
    "configs",
    "dist",
  ],
}
