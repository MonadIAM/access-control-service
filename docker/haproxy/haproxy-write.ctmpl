global
    maxconn 200

defaults
    mode tcp
    retries 2
    timeout client 30m
    timeout connect 4s
    timeout server 30m
    timeout check 5s

listen stats
    mode http
    bind *:7000
    stats enable
    stats uri /

listen postgres_write
    bind *:5432
{{ range service "master.access-control-service" }}
    server {{ .Address }} {{ .Address }}:{{ .Port }} maxconn 100 check
{{ end }}
